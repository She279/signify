SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-different-long-random-string
# Leave DATABASE_URL unset to use the default absolute path
# (backend/database/signify.db). Only set this if you want a custom location.
# DATABASE_URL=sqlite:////absolute/path/to/signify.db
# Comma-separated public frontend origins. Use the exact deployed frontend URL.
# Example: CORS_ORIGINS=https://signify.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
